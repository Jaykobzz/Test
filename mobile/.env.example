# Kopiera till .env och fyll i. Allt som ska nå appen måste heta EXPO_PUBLIC_*.

# Låt stå som 1 för att köra hela appen mot det inbyggda mock-backendet —
# ingen Supabase behövs, allt sparas lokalt på telefonen. Sätt 0 när du har
# ett Supabase-projekt uppe.
EXPO_PUBLIC_USE_MOCK_BACKEND=1

EXPO_PUBLIC_SUPABASE_URL=https://ditt-projekt.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=din-anon-nyckel
